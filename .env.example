# 燃稿 (RánGǎo) — Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# --- LLM API ---
# Required. Supports any OpenAI-compatible API.
RANGAO_LLM_PROVIDER=deepseek
RANGAO_LLM_API_KEY=sk-your-deepseek-api-key-here
RANGAO_LLM_BASE_URL=https://api.deepseek.com
RANGAO_LLM_MODEL=deepseek-chat
RANGAO_LLM_REASONING_MODEL=deepseek-reasoner
RANGAO_LLM_TEMPERATURE=0.7
RANGAO_LLM_MAX_TOKENS=8000

# --- WeChat Official Account (optional — only needed for auto-publish) ---
# Get these from: https://mp.weixin.qq.com/ → Settings → Developer Tools
RANGAO_WECHAT_APPID=wx_your_app_id_here
RANGAO_WECHAT_APPSECRET=your_app_secret_here
RANGAO_WECHAT_TOKEN_CACHE=.wechat_token.json

# --- Sci-Hub Mirror ---
RANGAO_SCIHUB_MIRROR=https://sci-hub.se

# --- Crossref (optional, use "mail@example.com" for basic usage) ---
RANGAO_CROSSREF_EMAIL=mail@example.com

# --- Paths ---
RANGAO_OUTPUT_DIR=output
RANGAO_CACHE_DIR=.cache

# --- Pipeline Defaults ---
RANGAO_AUTO_PUBLISH=false
RANGAO_SKIP_DOWNLOAD=false
